<section class="share-section" aria-label="分享文章" data-share-title="<%= page.title %>" data-quote-attribution="<%= page.quote_attribution || '' %>" data-share-description="<%= paper_summary(page) %>" data-share-url="<%= full_url_for(page.path) %>">
  <h2>分享这篇<%= paper_kind(page) %></h2>
  <div class="share-actions">
    <button class="ui-button share-trigger" type="button" popovertarget="article-share-options" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M7 11H4v10h16V11h-3"/></svg>
      分享文章<svg class="share-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
    </button>
    <div class="share-popover" id="article-share-options" role="group" aria-label="分享方式">
      <button class="ui-button share-option copy-link" type="button" data-clipboard-text="<%= full_url_for(page.path) %>" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 13 4-4m-6 5-2 2a3 3 0 0 0 4 4l4-4a3 3 0 0 0 0-4m2-2 2-2a3 3 0 0 0-4-4l-4 4a3 3 0 0 0 0 4"/></svg><span>复制链接</span>
      </button>
      <a class="ui-button share-option share-x" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(full_url_for(page.path)) %>&amp;text=<%= encodeURIComponent(page.title) %>" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h4l12 16h-4L4 4Zm16 0-7 8m-2 2-7 6"/></svg><span>分享到 X</span>
      </a>
      <a class="ui-button share-option" href="<%= url_for(paper_card_path(page)) %>" download="AresNing-article.png">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 17 6-6 5 5 3-3 4 4"/><circle cx="16" cy="8" r="1"/></svg><span>保存文章封面</span>
      </a>
      <button class="ui-button share-option native-share" type="button" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg><span>更多方式…<small>打开系统分享</small></span>
        <svg class="share-external" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7m0-7L11 13M10 5H4v15h15v-6"/></svg>
      </button>
    </div>
    <button class="ui-button outlined-button quote-open" type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 17 6-6 5 5 3-3 4 4"/><circle cx="16" cy="8" r="1"/></svg>保存摘录图片</button>
  </div>
  <p class="share-status muted" role="status" aria-live="polite"></p>
</section>
<div class="ui-dialog" id="quote-dialog" aria-hidden="true" aria-labelledby="quote-title">
  <div class="dialog-overlay" data-a11y-dialog-hide></div>
  <div class="dialog-panel quote-panel" role="document">
    <div class="dialog-heading"><h2 id="quote-title">保存摘录</h2><button class="ui-button icon-button" type="button" data-a11y-dialog-hide aria-label="关闭摘录"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <label for="quote-select">选择内容</label><select class="ui-input" id="quote-select" autofocus></select>
    <p class="muted">图片保留段落原文与出处；引用他人内容时，请保留原作者署名。</p>
    <img class="quote-preview" alt="摘录图片预览" width="1080" height="1440" hidden>
    <p class="quote-status muted" role="status" aria-live="polite"></p>
    <a class="ui-button outlined-button quote-download" download="AresNing-excerpt.png" hidden>保存 PNG 图片</a>
  </div>
</div>
