<div class="index-page collection-page">
  <header class="collection-header"><p class="eyebrow">ARCHIVE</p><h1><%= page.category || page.tag || '归档' %></h1><p class="muted"><%= page.category ? '分类下的文章' : page.tag ? '标签下的文章' : '写下的思考，留在这里。' %></p><nav class="taxonomy-links" aria-label="文章分类导航"><a href="<%= url_for('/archives/') %>"<%- !page.category && !page.tag ? ' aria-current="page"' : '' %>>全部</a><a href="<%= url_for('/categories/') %>">分类</a><a href="<%= url_for('/tags/') %>">标签</a></nav></header>
  <% let lastGroup = null; page.posts.each(function(post) { const known = paper_has_date(post); const group = known ? date(post.date, 'YYYY') : '未标注日期'; if (group !== lastGroup) { %><h2 class="archive-year"><%= group %></h2><% lastGroup = group; } %>
    <article class="archive-row"><% if (known) { %><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time><% } %><h3><a href="<%= url_for(post.path) %>"><%= post.title || '无题' %></a></h3><span aria-hidden="true">↗</span></article>
  <% }); %>
  <%- partial('_partial/pagination') %>
</div>
